{
  "name": "homesec-panel",
  "private": true,
  "version": "0.0.0",
  "description": "Build and test tooling for the Security Assistant panel",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check-bundle": "node build.mjs && git diff --exit-code -- ../custom_components/homesec/frontend/homesec-panel.js",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3"
  }
}
